{
  "name": "moebius",
  "version": "0.5.12",
  "description": "Local-first multi-agent collaboration for Codex, with an optional Electron desktop app.",
  "keywords": [
    "ai-agents",
    "codex",
    "electron",
    "multi-agent",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tranfu-labs/moebius.git"
  },
  "homepage": "https://github.com/tranfu-labs/moebius#readme",
  "bugs": {
    "url": "https://github.com/tranfu-labs/moebius/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/runner.ts",
    "desktop": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning pnpm --filter @moebius/desktop dev",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node scripts/generate-brand-assets.mjs --check",
    "check:boundaries": "tsx scripts/check-import-boundaries.ts",
    "release:prepare-update": "tsx scripts/release/prepare-update-metadata.ts",
    "release:validate-update": "tsx scripts/release/validate-update-metadata.ts",
    "release:upload-assets": "tsx scripts/release/upload-assets.ts",
    "test": "tsx scripts/test.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @moebius/desktop typecheck && pnpm --filter @moebius/console-ui typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cross-env": "7.0.3",
    "playwright": "^1.61.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "mdast-util-from-markdown": "^2.0.3",
    "node-pty": "1.1.0",
    "smol-toml": "^1.7.0",
    "typebox": "1.3.7",
    "yaml": "^2.8.1"
  }
}
