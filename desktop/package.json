{
  "name": "@moebius/desktop",
  "version": "0.5.15",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @moebius/console-ui build && node scripts/build-native.mjs && node scripts/build.mjs",
    "dev": "node scripts/dev-electron.mjs",
    "dev:web-shell": "node scripts/dev-web-shell.mjs",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm --workspace-root brand:check && pnpm build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@moebius/console-ui": "workspace:*",
    "electron-updater": "^6.3.9",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.4.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.0.0",
    "vite": "^5.4.11",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "io.tranfu.moebius",
    "productName": "Moebius",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "../agents",
        "to": "seed/agents"
      },
      {
        "from": "../.agents/skills",
        "to": "seed/skills"
      },
      {
        "from": "../config.toml",
        "to": "seed/config.toml"
      },
      {
        "from": "../seeds/teams",
        "to": "seed/teams"
      },
      {
        "from": "native/build/MoebiusPermissionBridge.app",
        "to": "native/MoebiusPermissionBridge.app"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "../assets/brand/generated/app-icon-1024.png",
      "identity": "Shenzhen Wang Chuan Fu Technology Co., Ltd. (QV657S58FL)",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tranfu-labs",
        "repo": "moebius"
      }
    ]
  }
}
