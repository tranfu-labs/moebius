{
  "name": "@moebius/console-ui",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./console/markdown-file-reference-plan": {
      "types": "./dist/console/markdown-file-reference-plan.d.ts",
      "import": "./dist/markdown-file-reference-plan.js"
    },
    "./console/agent-form-model": {
      "types": "./dist/console/agent-form-model.d.ts",
      "import": "./dist/agent-form-model.js"
    },
    "./console/agent-form-protocol": {
      "types": "./dist/console/agent-form-protocol.d.ts",
      "import": "./dist/agent-form-protocol.js"
    },
    "./globals.css": "./dist/style.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "node scripts/build-storybook-temp.mjs",
    "check:storybook": "node ../../scripts/check-story-catalog.mjs && node scripts/build-storybook-temp.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.1",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-harden": "^1.1.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^5.4.11",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
